{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "src/app.ts",
    "src/automation/process-comment.ts",
    "src/index.ts",
    "src/runtime.ts",
    "src/config/environment.ts",
    "src/database/database.ts",
    "src/database/postgres-oauth-states.ts",
    "src/database/postgres-repositories.ts",
    "src/database/repositories.ts",
    "src/logging/logger.ts",
    "src/instagram/login-client.ts",
    "src/instagram/comment-reply-client.ts",
    "src/instagram/media-client.ts",
    "src/instagram/webhook-client.ts",
    "src/instagram/webhook-events.ts",
    "src/middleware/session.ts",
    "src/routes/auth.ts",
    "src/routes/automation.ts",
    "src/routes/health.ts",
    "src/routes/instagram-auth.ts",
    "src/routes/instagram-webhook.ts",
    "src/routes/me.ts",
    "src/routes/media.ts",
    "src/security/aes-gcm-token-protector.ts",
    "src/security/oauth-state.ts",
    "src/security/session-cookie.ts",
    "src/security/session-token.ts",
    "src/security/token-protector.ts"
  ],
  "excludePrivate": true,
  "out": "../../dist/docs/api-code",
  "readme": "none",
  "requiredToBeDocumented": [
    "Function",
    "Interface",
    "Method",
    "Property",
    "TypeAlias",
    "Variable"
  ],
  "treatWarningsAsErrors": true,
  "validation": {
    "invalidLink": true,
    "notDocumented": true
  }
}
