{
  "name": "@instagram-automation/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:migrate": "tsx --env-file=../../.env.local scripts/migrations.ts migrate",
    "db:migrate:status": "tsx --env-file=../../.env.local scripts/migrations.ts status",
    "dev": "tsx watch --env-file=../../.env.local src/server.ts",
    "docs:code": "typedoc --options typedoc.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:integration": "RUN_DATABASE_INTEGRATION_TESTS=true vitest run src/database/postgres-repositories.integration.test.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.scripts.json"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@hono/swagger-ui": "0.6.1",
    "@hono/zod-openapi": "1.6.1",
    "hono": "4.13.5",
    "postgres": "3.4.9",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "tsx": "4.23.13",
    "typedoc": "0.28.20",
    "vitest": "4.1.11"
  }
}
