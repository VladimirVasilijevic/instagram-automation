NODE_ENV=development

# Public frontend origin. Set to the production HTTPS origin in Vercel.
# OAuth start and callback must use the same browser origin for the binding cookie.
APP_BASE_URL=http://localhost:5173
# Reserved local API address; browser requests use same-origin /api paths.
API_BASE_URL=http://localhost:3000
API_PORT=3000

# Use the transaction pooler at port 6543 for the application runtime.
DATABASE_URL=
# Used by local migration commands; do not add this variable to the Vercel runtime.
DATABASE_MIGRATION_URL=

# Instagram App ID and Instagram App Secret from API setup with Instagram login.
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v24.0
# Exact registered callback, including /api/auth/instagram/callback.
# A production callback cannot complete a login started on localhost.
META_REDIRECT_URI=
META_WEBHOOK_VERIFY_TOKEN=

SESSION_COOKIE_NAME=igauto_session
SESSION_TTL_SECONDS=604800

# Generate a 32-byte Base64 value and store it as a server-only secret.
TOKEN_ENCRYPTION_KEY=
